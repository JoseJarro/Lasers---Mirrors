@startuml

class lasers.Juego{


-contadorTurnos : int
-estado : bool


+cambiarNivel()
+verificarEstado()

}

class lasers.Nivel{

-celdas : obj[]
-bloques : obj[]
-emisor : obj
-ovjetivos[]
-nivel : obj[]

+crearNivel()
-crearEmisor()
-crearObjetivos()
-crearCeldas()
-crearBloques()
+pasarTurno()

}

class lasers.Emisor{

-direccion : str
-posicionx : int
-posiciony : int

+emitirLaser()

}

class lasers.Objetivo{

-posicionx : int
-posiciony : int
-estado : bool

+objetivoAlcanzado()

}

class Celda{

-posicionx :int
-posiciony : int
-piso : bool

+esPiso()

}

interface lasers.Bloque{

-posicionx : int
-posiciony : int

}


class BloqueOpacoFijo{

+ comportamientoBloque()

}


class BloqueOpacoMovil{

+ moverBloque()
+ comportamientoBloque()

}

class BloqueEspejo{

+ moverBloque()
+ comportamientoBloque()

}

class BloqueVidrio{

+ moverBloque()
+ comportamientoBloque()

}

class BloqueCristal{

+ moverBloque()
+ comportamientoBloque()

}

interface elemento{

-posicionx
-posiciony
}

interface BloqueMovil{
+mover()
}

lasers.Juego "1" *--> "1" lasers.Nivel

lasers.Nivel "1" *--> "n" elemento

lasers.Nivel "1" *--> "n" lasers.Bloque
elemento "1" <|-- "n" Celda
elemento "1" <|-- "n" lasers.Emisor
elemento "1" <|-- "n" lasers.Objetivo

BloqueOpacoFijo ---|> lasers.Bloque
BloqueOpacoMovil ---|> lasers.Bloque
BloqueEspejo ---|> lasers.Bloque
BloqueVidrio ---|> lasers.Bloque
BloqueCristal ---|> lasers.Bloque


BloqueOpacoMovil ..|> BloqueMovil
BloqueEspejo ..|> BloqueMovil
BloqueVidrio ..|> BloqueMovil
BloqueCristal ..|> BloqueMovil


@enduml